# URL da API do Trabalho 2 (opcional).
# Se não for definida, o app usa automaticamente o IP da máquina que está rodando o Expo (rede local) na porta 3000.
# Descubra o IP da máquina com `ipconfig` (IPv4 do Wi-Fi) e use-o aqui para forçar um endereço específico.
EXPO_PUBLIC_API_URL=http://192.168.15.17:3000/api/v1
